;; === Это куда сохранять настройки
(setq emacs_d_dir "{{ if .android }}{{ .home_dir }}/.emacs.d{{ else }}{{ .abs_roamg_cfg_dir }}/{{ if .windows }}.emacs.d{{ else }}emacs{{ end }}{{ end }}")
(setq custom-file (concat emacs_d_dir "/custom.el"))
(if (file-exists-p custom-file)
    (load custom-file)
    (progn
      ; Настройки по умолчанию
      ;; --- Всякая кастомизация
      (custom-set-variables
       '(column-number-mode t)
       '(custom-enabled-themes '(misterioso))
       '(fringe-mode nil nil (fringe))
       '(global-display-line-numbers-mode t)
       '(inhibit-startup-screen t)
       '(menu-bar-mode {{ if (or .android .windows) }}t{{ else }}nil{{ end }})
       '(size-indication-mode t)
       '(tool-bar-mode {{ if .android }}t{{ else }}nil{{ end }})
       '(current-language-environment "Russian")
       '(default-input-method "russian-computer")
       '(ispell-dictionary "{{ if (lookPath "hunspell") }}ru_RU{{ else }}ru-yeyo{{ end }}")
       '(org-startup-truncated nil)
       '(org-startup-indented t)
       '(use-package-always-ensure t)
       )
      ;; --- Это любимый шрифт взамен шрифтов по умолчанию
      (custom-set-faces
       '(default ((t ({{ if not .android }}:family "{{ .style.fav_font_name_nf_mono }}" :foundry "UKWN"{{ end }} :slant normal :weight normal :height {{ if .android }}240{{ else if eq .dpi.level .dpi.normal }}140{{ else if eq .dpi.level .dpi.retina }}180{{else}}160{{ end }} :width normal))))
       '(mode-line ((t (:background "gray30" :box (:line-width (1 . 1) :color "dark gray") {{ if not .android }}:family "{{ .style.fav_font_name_nf_mono }}"{{ end }}))))
       '(markdown-inline-code-face ((t (:inherit font-lock-constant-face))))
       '(markdown-code-face ((t (:inherit font-lock-constant-face))))
       )
      )
    )

;; === Ну и расширенные настройки, пакеты и т.д.
{{- if not .android }}
(when (file-exists-p (concat emacs_d_dir "/setup.el"))
  (load (concat emacs_d_dir "/setup.el")))
{{- end }}

