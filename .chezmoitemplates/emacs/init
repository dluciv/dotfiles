;; === Это куда сохранять настройки
(setq emacs_d_dir "{{ if .android }}{{ .home_dir }}/.emacs.d{{ else }}{{ .abs_roamg_cfg_dir }}/{{ if .windows }}.emacs.d{{ else }}emacs{{ end }}{{ end }}")
(setq custom-file (concat emacs_d_dir "/custom.el"))

;; === Настройки по умолчанию
;; --- Всякая кастомизация
(load-theme 'misterioso t)
(fringe-mode 0)
(setq inhibit-startup-screen t)
(setq current-language-environment "Russian")
(setq default-input-method "russian-computer")
(setq ispell-dictionary "{{ if (lookPath "hunspell") }}ru_RU{{ else }}ru-yeyo{{ end }}")
(setq org-startup-truncated nil)
(setq org-startup-indented t)
(setq use-package-always-ensure t)
(setq-default tab-width 4)

(when (fboundp 'indent-tabs-mode) (indent-tabs-mode -1))
(when (fboundp 'global-display-line-numbers-mode) (global-display-line-numbers-mode 1))
(when (fboundp 'column-number-mode) (column-number-mode 1))
(when (fboundp 'menu-bar-mode) (menu-bar-mode {{ if (or .android .windows) }}1{{ else }}-1{{ end }}))
(when (fboundp 'tool-bar-mode) (tool-bar-mode {{ if .android }}1{{ else }}-1{{ end }}))
(when (fboundp 'size-indication-mode) (size-indication-mode 1))

;; --- Это любимый шрифт взамен шрифтов по умолчанию
(set-face-attribute 'default nil
					{{ if not .android }}:family "{{ .style.fav_font_name_nf_mono }}" :foundry "UKWN"{{ end }}
					:height {{ if .android }}240{{ else if eq .dpi.level .dpi.normal }}140{{ else if eq .dpi.level .dpi.retina }}180{{else}}160{{ end }})
(set-face-attribute 'mode-line nil
					:background "gray30" {{ if not .android }}:family "{{ .style.fav_font_name_nf_mono }}"{{ end }})

(when (file-exists-p custom-file)
  (load custom-file))

;; === Ну и расширенные настройки, пакеты и т.д.
{{- if not .android }}
(when (file-exists-p (concat emacs_d_dir "/setup.el"))
  (load (concat emacs_d_dir "/setup.el")))
{{- end }}

;; === Это чтобы понять, что мы дошли таки до конца файла
(message "Got to the end of init.el (.emacs)")
