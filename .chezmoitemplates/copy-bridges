#!/bin/zsh -l
# cumbersome to run under Termux too

set -ue

sub='{{ .data.torbridges.url }}'
fixed_content='{{- range .data.torbridges.fixed }}
{{ . }}
{{- end }}'
sub_content=$(curl -L "$sub")
bridges=$({echo "$fixed_content"; echo $sub_content } | grep -v '^\s*\(#\|$\)' )
echo $bridges | bash $(which cccp) c
sleep 2
exit

echo termux CB may broken again, bridges are following:
echo '----------------------------------'
echo $bridges
read
