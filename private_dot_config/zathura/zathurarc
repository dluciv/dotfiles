# Включить плавную прокрутку мышью
set scroll-step 50

# Запоминать последнюю открытую страницу и настройки масштаба для каждого файла
set database "sqlite"

# Копировать выделенный текст прямо в буфер обмена системы
set selection-clipboard "clipboard"

# Настройка внешнего вида (например, темная тема для чтения ночью)
# set recolor "true"
# set recolor-darkedit "true"

# Отображать страницы в режиме "книги" (две страницы рядом), если экран широкий
set pages-per-row 1
# Переключение режима страниц по горячей клавише 'd'
map d toggle_page_mode
