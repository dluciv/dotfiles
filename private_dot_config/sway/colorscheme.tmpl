# Colors generated by chezmoi from the active color theme
#
# You can use these variables anywhere in the sway configuration file.

{{- $c := .style.colors }}

set $bg          #{{ $c.ui.global.background.normal }}
set $bg_lighter  #{{ $c.ui.chrome.background.normal }}
set $fg          #{{ $c.ui.global.foreground.normal }}
set $fg_dim      #{{ $c.ui.global.foreground.dark }}
set $fg_light    #{{ $c.ui.global.foreground.light }}
set $comment     #{{ $c.syntax.comment.default }}
set $selection   #{{ $c.ui.selection.background }}
set $accent      #{{ $c.ui.accent.normal }}
set $error       #{{ $c.ui.status.error }}
set $warning     #{{ $c.ui.status.warning }}
set $success     #{{ $c.ui.status.success }}
set $info        #{{ $c.ui.status.info }}
