{{- /* Managed by chezmoi. Target: ~/.config/tinted-theming/tinty/config.toml */ -}}
# Generated from the active Base24 scheme by tinty:
#   ~/.chezmoitemplates/color_theme.yml  (in the chezmoi source dir)
# If present, it overrides the Base24 fallback theme.
default-scheme = "base24-space-gray-eighties"

[[items]]
name = "chezmoi"
path = "{{ .chezmoi.homeDir }}/.config/tinted-theming"
themes-dir = "themes"
supported-systems = ["base24"]
hook = """if ! cmp -s "$TINTY_THEME_FILE_PATH" "{{ .chezmoi.sourceDir }}/.chezmoitemplates/color_theme.yml"; then
    cp -f "$TINTY_THEME_FILE_PATH" "{{ .chezmoi.sourceDir }}/.chezmoitemplates/color_theme.yml"
    chezmoi apply --init
fi"""
