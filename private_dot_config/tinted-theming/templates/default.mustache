# {{ scheme-name }} — {{ scheme-system }} scheme
# author: {{ scheme-author }}
base00: &base00 "{{ base00-hex }}"
base01: &base01 "{{ base01-hex }}"
base02: &base02 "{{ base02-hex }}"
base03: &base03 "{{ base03-hex }}"
base04: &base04 "{{ base04-hex }}"
base05: &base05 "{{ base05-hex }}"
base06: &base06 "{{ base06-hex }}"
base07: &base07 "{{ base07-hex }}"
base08: &base08 "{{ base08-hex }}"
base09: &base09 "{{ base09-hex }}"
base0A: &base0A "{{ base0A-hex }}"
base0B: &base0B "{{ base0B-hex }}"
base0C: &base0C "{{ base0C-hex }}"
base0D: &base0D "{{ base0D-hex }}"
base0E: &base0E "{{ base0E-hex }}"
base0F: &base0F "{{ base0F-hex }}"
base10: &base10 "{{ base10-hex }}"
base11: &base11 "{{ base11-hex }}"
base12: &base12 "{{ base12-hex }}"
base13: &base13 "{{ base13-hex }}"
base14: &base14 "{{ base14-hex }}"
base15: &base15 "{{ base15-hex }}"
base16: &base16 "{{ base16-hex }}"
base17: &base17 "{{ base17-hex }}"

# ANSI terminal colors, per the standard Base24 -> ANSI mapping.
# Each entry reuses the baseXX color defined above (YAML alias).
# regular:
ansi0: *base00  # ANSI Black          = base00
ansi1: *base08  # ANSI Red            = base08
ansi2: *base0B  # ANSI Green          = base0B
ansi3: *base0A  # ANSI Yellow         = base0A
ansi4: *base0D  # ANSI Blue           = base0D
ansi5: *base0E  # ANSI Magenta        = base0E
ansi6: *base0C  # ANSI Cyan           = base0C
ansi7: *base05  # ANSI White          = base05
# bright:
ansi8: *base03  # ANSI Bright Black   = base03
ansi9: *base12  # ANSI Bright Red     = base12
ansiA: *base14  # ANSI Bright Green   = base14
ansiB: *base13  # ANSI Bright Yellow  = base13
ansiC: *base16  # ANSI Bright Blue    = base16
ansiD: *base17  # ANSI Bright Magenta = base17
ansiE: *base15  # ANSI Bright Cyan    = base15
ansiF: *base07  # ANSI Bright White   = base07
