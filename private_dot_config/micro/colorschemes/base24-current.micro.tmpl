# micro colorscheme, generated by chezmoi from the active color theme (syntax section)

{{- $c := .style.colors }}

color-link default "#{{ $c.syntax.source }},#{{ $c.ui.global.background.normal }}"

color-link comment "#{{ $c.syntax.comment.default }}"

color-link constant "#{{ $c.syntax.constant.default }}"
color-link constant.specialChar "#{{ $c.syntax.constant.character.escape }}"
color-link constant.string "#{{ $c.syntax.string.default }}"

color-link identifier "#{{ $c.syntax.variable.language }}"
color-link identifier.class "#{{ $c.syntax.entity.name.type.class }}"

color-link preproc "#{{ $c.syntax.meta.annotation }}"

color-link special "#{{ $c.syntax.support.variable }}"

color-link statement "#{{ $c.syntax.keyword.default }}"

color-link symbol.operator "#{{ $c.syntax.keyword.operator }}"
color-link symbol.tag "#{{ $c.syntax.entity.name.tag }}"

color-link type "#{{ $c.syntax.entity.name.type.default }}"

color-link underlined "#{{ $c.syntax.markup.underline }}"

color-link error "bold #{{ $c.ui.global.background.normal }},#{{ $c.syntax.invalid.illegal }}"
color-link todo "bold #{{ $c.syntax.markup.changed }},#{{ $c.ui.chrome.background.normal }}"
color-link hlsearch "#{{ $c.ui.chrome.background.normal }},#{{ $c.ui.highlight.search.foreground }}"
color-link statusline "#{{ $c.ui.global.foreground.dark }},#{{ $c.ui.selection.background }}"
color-link tabbar "#{{ $c.syntax.comment.default }},#{{ $c.ui.chrome.background.normal }}"
color-link indent-char "#{{ $c.syntax.comment.default }}"
color-link line-number "#{{ $c.syntax.comment.default }},#{{ $c.ui.chrome.background.normal }}"
color-link current-line-number "#{{ $c.ui.global.foreground.dark }},#{{ $c.ui.chrome.background.normal }}"

color-link diff-added "#{{ $c.syntax.string.default }},#{{ $c.ui.chrome.background.normal }}"
color-link diff-modified "#{{ $c.syntax.comment.default }},#{{ $c.ui.chrome.background.normal }}"
color-link diff-deleted "#{{ $c.syntax.invalid.illegal }},#{{ $c.ui.chrome.background.normal }}"
color-link gutter-error "#{{ $c.syntax.invalid.illegal }},#{{ $c.ui.chrome.background.normal }}"
color-link gutter-warning "#{{ $c.syntax.markup.changed }},#{{ $c.ui.chrome.background.normal }}"

color-link cursor-line "#{{ $c.ui.highlight.line.background }}"
color-link color-column "#{{ $c.ui.highlight.line.background }}"
