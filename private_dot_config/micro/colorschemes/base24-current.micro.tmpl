{{- $scheme := "" -}}
{{- if (stat (joinPath .chezmoi.sourceDir ".chezmoitemplates" "color_theme.yml")) -}}
{{-   $scheme = includeTemplate "color_theme.yml" | fromYaml -}}
{{- else -}}
{{-   $scheme = includeTemplate "color_theme_fallback.yml" | fromYaml -}}
{{- end -}}
# micro colorscheme, generated by chezmoi from the active Base24 scheme

color-link default "#{{ $scheme.base05 }},#{{ $scheme.base00 }}"

color-link comment "#{{ $scheme.base03 }}"

color-link constant "#{{ $scheme.base09 }}"
color-link constant.specialChar "#{{ $scheme.base0F }}"
color-link constant.string "#{{ $scheme.base0B }}"

color-link identifier "#{{ $scheme.base08 }}"
color-link identifier.class "#{{ $scheme.base0A }}"

color-link preproc "#{{ $scheme.base0A }}"

color-link special "#{{ $scheme.base0C }}"

color-link statement "#{{ $scheme.base08 }}"

color-link symbol.operator "#{{ $scheme.base05 }}"
color-link symbol.tag "#{{ $scheme.base05 }}"

color-link type "#{{ $scheme.base0A }}"

color-link underlined "#{{ $scheme.base08 }}"

color-link error "bold #{{ $scheme.base00 }},#{{ $scheme.base08 }}"
color-link todo "bold #{{ $scheme.base0A }},#{{ $scheme.base01 }}"
color-link hlsearch "#{{ $scheme.base01 }},#{{ $scheme.base0A }}"
color-link statusline "#{{ $scheme.base04 }},#{{ $scheme.base02 }}"
color-link tabbar "#{{ $scheme.base03 }},#{{ $scheme.base01 }}"
color-link indent-char "#{{ $scheme.base03 }}"
color-link line-number "#{{ $scheme.base03 }},#{{ $scheme.base01 }}"
color-link current-line-number "#{{ $scheme.base04 }},#{{ $scheme.base01 }}"

color-link diff-added "#{{ $scheme.base0B }},#{{ $scheme.base01 }}"
color-link diff-modified "#{{ $scheme.base03 }},#{{ $scheme.base01 }}"
color-link diff-deleted "#{{ $scheme.base08 }},#{{ $scheme.base01 }}"
color-link gutter-error "#{{ $scheme.base08 }},#{{ $scheme.base01 }}"
color-link gutter-warning "#{{ $scheme.base0D }},#{{ $scheme.base01 }}"

color-link cursor-line "#{{ $scheme.base01 }}"
color-link color-column "#{{ $scheme.base01 }}"
