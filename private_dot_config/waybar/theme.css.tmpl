/* Colors generated by chezmoi from the active color theme */

{{- $c := .style.colors }}

@define-color bg         #{{ $c.ui.global.background.normal }};
@define-color bg_dark    #{{ $c.ui.global.background.dark }};
@define-color bg_lighter #{{ $c.ui.chrome.background.normal }};
@define-color bg_light   #{{ $c.ui.global.background.light }};
@define-color fg         #{{ $c.ui.global.foreground.normal }};
@define-color fg_dim     #{{ $c.ui.global.foreground.dark }};
@define-color fg_light   #{{ $c.ui.global.foreground.light }};
@define-color comment    #{{ $c.syntax.comment.default }};
@define-color selection  #{{ $c.ui.selection.background }};
@define-color accent     #{{ $c.ui.accent.normal }};
@define-color success    #{{ $c.ui.status.success }};
@define-color warning    #{{ $c.ui.status.warning }};
@define-color error      #{{ $c.ui.status.error }};
@define-color info       #{{ $c.ui.status.info }};
@define-color deprecated #{{ $c.ui.deprecated }};
