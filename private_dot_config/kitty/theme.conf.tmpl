# vim:ft=kitty
# Colors generated by chezmoi from the active color theme

{{- $c := .style.colors }}

background #{{ $c.ui.global.background.normal }}
foreground #{{ $c.ui.global.foreground.normal }}
selection_background #{{ $c.ui.selection.background }}
selection_foreground #{{ $c.ui.selection.foreground }}
url_color #{{ $c.ui.link.normal }}
cursor #{{ $c.ui.cursor.normal.background }}
active_border_color #{{ $c.ui.accent.normal }}
inactive_border_color #{{ $c.ui.border.normal }}

active_tab_background #{{ $c.ui.accent.normal }}
active_tab_foreground #{{ $c.ui.global.background.normal }}
inactive_tab_background #{{ $c.ui.chrome.background.dark }}
inactive_tab_foreground #{{ $c.ui.chrome.foreground.dark }}
tab_bar_background #{{ $c.ui.chrome.background.dark }}

# normal
color0  #{{ $c.ansi.ansi_0 }}
color1  #{{ $c.ansi.ansi_1 }}
color2  #{{ $c.ansi.ansi_2 }}
color3  #{{ $c.ansi.ansi_3 }}
color4  #{{ $c.ansi.ansi_4 }}
color5  #{{ $c.ansi.ansi_5 }}
color6  #{{ $c.ansi.ansi_6 }}
color7  #{{ $c.ansi.ansi_7 }}

# bright
color8  #{{ $c.ansi.ansi_8 }}
color9  #{{ $c.ansi.ansi_9 }}
color10 #{{ $c.ansi.ansi_a }}
color11 #{{ $c.ansi.ansi_b }}
color12 #{{ $c.ansi.ansi_c }}
color13 #{{ $c.ansi.ansi_d }}
color14 #{{ $c.ansi.ansi_e }}
color15 #{{ $c.ansi.ansi_f }}

# extended palette colors
color16 #{{ $c.palette.orange.normal }}
color17 #{{ $c.palette.brown.normal }}
color18 #{{ $c.palette.gray.dim }}
color19 #{{ $c.palette.gray.normal }}
color20 #{{ $c.palette.gray.bright }}
color21 #{{ $c.palette.white.dim }}
